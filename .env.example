# ========================================================
# ROOTS DENTAL CLINIC - SUPABASE POSTGRESQL CONFIGURATION
# ========================================================

# Supabase Transaction Connection Pooler (Port 6543) - Used for Prisma queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Port 5432) - Used for migrations and db push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# JWT Secret for Admin Session Tokens (generate a secure random 32+ character string)
AUTH_SECRET="roots_dental_jwt_secret_production_2026_super_secure_key_change_me"

# Public Website Base URL
NEXT_PUBLIC_SITE_URL="https://rootsdentalclinic.in"

# Clinic Public Metadata
NEXT_PUBLIC_CLINIC_PHONE="+91 98765 43210"
NEXT_PUBLIC_CLINIC_WHATSAPP="+919876543210"
NEXT_PUBLIC_CLINIC_NAME="Roots Super Speciality Dental Clinic"
