# ========================================================
# ROOTS DENTAL CLINIC - ENVIRONMENT CONFIGURATION
# ========================================================

# Self-contained SQLite Database
DATABASE_URL="file:./dev.db"

# JWT Secret for Admin Authentication Session
AUTH_SECRET="roots_dental_jwt_secret_production_2026_super_secure_key"

# Public Website URL
NEXT_PUBLIC_SITE_URL="https://rootsdentalclinic.in"

# Clinic Public Metadata
NEXT_PUBLIC_CLINIC_PHONE="+91 98480 12345"
NEXT_PUBLIC_CLINIC_WHATSAPP="+919848012345"
NEXT_PUBLIC_CLINIC_NAME="Roots Super Speciality Dental Clinic"

# ========================================================
# EMAIL DELIVERY CONFIGURATION (Nodemailer SMTP / Gmail / Resend)
# ========================================================
# Option A: Using Gmail (Fastest & Free)
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Create an App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in below:
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Option B: Standard SMTP (Zoho, Resend, Sendgrid, Custom SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Roots Dental Clinic <appointments@rootsdental.com>"
